# Numbers Welzijn Portaal — kopieer naar .env.local en vul de secrets aan.
#
# De publieke waarden hieronder staan er al in; ze zijn opgehaald uit het
# Supabase-project "thabusiness" en het Vercel-project "numbers".
# De twee secrets staan bewust leeg: die haal je zelf uit het dashboard en
# ze horen nooit in de repo.

# ---------------------------------------------------------------- Supabase
# Project "thabusiness" (ref wtkgbrwhkwmlqkcfkmqz, eu-central-1).
# Onze tabellen staan onder de prefix np_; de andere tabellen in dit project
# zijn van andere apps en blijven met rust.
SUPABASE_URL=https://wtkgbrwhkwmlqkcfkmqz.supabase.co

# Publiek en veilig in clientcode. RLS laat hiermee niets van np_ toe —
# alleen handig als je later een browser-client wilt.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UEVkU5VJMLOeBwiRptHiZQ_xUp8JQ1M

# Server-only. Dit is de sleutel waarmee de app daadwerkelijk leest en schrijft,
# want elke np_-tabel heeft alleen een service_role-policy.
# Ophalen: Supabase → Project Settings → API keys → service_role. Nooit in
# clientcode, nooit met NEXT_PUBLIC_ ervoor.
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------- Maileroo
# Maileroo-dashboard → API keys. Verifieer eerst het afzenddomein: DNS is de
# enige wachttijd op deze lijst die je niet kunt inhalen.
MAILEROO_API_KEY=
MAILEROO_FROM=

# ---------------------------------------------------------------- Anthropic
# Alleen server-side aanroepen vanuit /api/insights.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Base URL
# De link in de uitnodigingsmail moet absoluut zijn — localhost werkt niet
# in een inbox. Productiedomein van het Vercel-project "numbers".
NEXT_PUBLIC_BASE_URL=https://numbers-silk.vercel.app
